# Keep this relative in development so Vite proxies API requests to Django.
VITE_API_BASE_URL=/api/v1

# Sentry — laisser VITE_SENTRY_DSN vide pour désactiver complètement (dev par défaut).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=

# PostHog — VITE_POSTHOG_ENABLED=false en dev pour ne pas polluer les
# analytics du pilote avec des sessions de développement.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_ENABLED=false
