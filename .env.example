DJANGO_SECRET_KEY=unsafe-development-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_COOKIE_SECURE=false
POSTGRES_DB=lopos
POSTGRES_USER=lopos
POSTGRES_PASSWORD=lopos
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433

# --- Déploiement (Railway) --------------------------------------------
# En local : laisser vide, les variables POSTGRES_* ci-dessus sont utilisées.
# Sur Railway : fourni automatiquement en attachant un service Postgres au
# service backend, rien à faire.
DATABASE_URL=

# Domaine du frontend en production (obligatoire dès que DJANGO_DEBUG=false) :
#   DJANGO_ALLOWED_HOSTS=api.lopos.app
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://lopos.app
#   DJANGO_CORS_ALLOWED_ORIGINS=https://lopos.app
#   DJANGO_COOKIE_SAMESITE=Lax    (suffit : lopos.app et api.lopos.app partagent le même site)
#   DJANGO_COOKIE_SECURE=true     (obligatoire en HTTPS)
#   DJANGO_CSRF_COOKIE_DOMAIN=.lopos.app   (partage uniquement le cookie CSRF entre les sous-domaines)
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_DOMAIN=

# Durcissement HTTPS optionnel, à activer une fois le déploiement validé (voir README).
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0

# Sentry (backend) — laisser SENTRY_DSN vide pour désactiver complètement.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# PostHog (backend) — utilisé uniquement pour les events déclenchés depuis le
# Django Admin (produits, stock, dashboard gérant). POSTHOG_ENABLED=false en
# local pour ne pas polluer les analytics du pilote avec des sessions de dev.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ENABLED=false
